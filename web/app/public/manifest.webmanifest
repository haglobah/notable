{
  "name": "Notable",
  "short_name": "Notable",
  "description": "Your Notable library: documents and notebooks from your Boox.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#e6e8e4",
  "theme_color": "#e6e8e4",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [{ "name": "file", "accept": ["application/pdf", "application/epub+zip", ".pdf", ".epub"] }]
    }
  }
}
