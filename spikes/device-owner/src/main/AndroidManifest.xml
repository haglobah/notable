<?xml version="1.0" encoding="utf-8"?>
<!--
  testOnly lets `adb shell dpm remove-active-admin` take device owner away again, so the spike can
  be undone without a factory reset. It also means it installs only with `adb install -t`.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- "List Onyx packages" needs to see every installed package. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_lock_lock"
        android:testOnly="true"
        tools:ignore="MissingApplicationIcon">

        <activity
            android:name=".SpikeActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Off until the "Make spike Home" button turns it on, so installing the spike never makes
          Android ask which home app to use.
        -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".SpikeActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
